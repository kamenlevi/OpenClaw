{
  "name": "openclaw-desktop",
  "version": "0.1.0",
  "description": "OpenClaw Mission Control — desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.openclaw.missioncontrol",
    "productName": "OpenClaw",
    "directories": {
      "buildResources": ".",
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "../.next/**",
      "../public/**",
      "../node_modules/**",
      "../package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
